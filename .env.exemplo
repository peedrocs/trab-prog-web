# Copie este arquivo para .env (na mesma pasta) e preencha. O .env fica fora do Git.
# Não use aspas nos valores.

# Mercado Pago: Access Token da conta de teste do vendedor (começa com APP_USR-)
MERCADOPAGO_ACCESS_TOKEN=
# chave secreta do webhook (Suas integrações > Webhooks > Configurar notificações)
MERCADOPAGO_WEBHOOK_SECRET=

# Google (OAuth 2.0) em https://console.cloud.google.com/apis/credentials
# URI de redirecionamento: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail de teste (Mailtrap > Email Testing > Inboxes > SMTP)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# endereço da loja usado nos links dos e-mails
LOJA_URL=http://localhost:8080
